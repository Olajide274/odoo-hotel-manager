<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hotel" model="ir.module.category">
        <field name="name">Hotel</field>
        <field name="sequence">50</field>
    </record>

    <!-- Receptionists also get Odoo's Billing and Contact Creation rights,
         so they can invoice guests and register payments at the front desk. -->
    <record id="group_hotel_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('base.group_partner_manager'))]"/>
    </record>

    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hotel"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_receptionist'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
