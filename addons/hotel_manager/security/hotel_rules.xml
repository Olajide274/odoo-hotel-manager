<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hotel_room_type_company" model="ir.rule">
        <field name="name">Hotel room type: own hotel only</field>
        <field name="model_id" ref="model_hotel_room_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hotel_room_company" model="ir.rule">
        <field name="name">Hotel room: own hotel only</field>
        <field name="model_id" ref="model_hotel_room"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hotel_booking_company" model="ir.rule">
        <field name="name">Hotel booking: own hotel only</field>
        <field name="model_id" ref="model_hotel_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hotel_booking_charge_company" model="ir.rule">
        <field name="name">Hotel booking charge: own hotel only</field>
        <field name="model_id" ref="model_hotel_booking_charge"/>
        <field name="domain_force">[('booking_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
