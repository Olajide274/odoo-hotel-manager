<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_room_view_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="room_type_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price_per_night"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'available'"
                       decoration-danger="status == 'occupied'"
                       decoration-warning="status in ('cleaning', 'maintenance')"/>
            </list>
        </field>
    </record>

    <record id="hotel_room_view_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_type_id"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_per_night"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_room_view_search" model="ir.ui.view">
        <field name="name">hotel.room.search</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="room_type_id"/>
                <filter name="available" string="Available" domain="[('status', '=', 'available')]"/>
                <filter name="occupied" string="Occupied" domain="[('status', '=', 'occupied')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Room Type" context="{'group_by': 'room_type_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_room_action" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
