<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_booking_view_calendar" model="ir.ui.view">
        <field name="name">hotel.booking.calendar</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings"
                     date_start="check_in"
                     date_stop="check_out"
                     color="room_id"
                     mode="month"
                     quick_create="0"
                     event_open_popup="1">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Add calendar to the existing Bookings action -->
    <record id="hotel_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,kanban,calendar,form</field>
    </record>
</odoo>
