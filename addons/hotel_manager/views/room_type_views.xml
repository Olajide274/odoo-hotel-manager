<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_room_type_view_list" model="ir.ui.view">
        <field name="name">hotel.room.type.list</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="price_per_night"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>

    <record id="hotel_room_type_view_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="price_per_night"/>
                            <field name="room_count"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this room type..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_room_type_action" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
