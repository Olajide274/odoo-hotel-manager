<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_booking_view_list" model="ir.ui.view">
        <field name="name">hotel.booking.list</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('cancelled', 'checked_out')">
                <field name="name"/>
                <field name="guest_name"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total_price"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'draft'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'checked_in'"/>
            </list>
        </field>
    </record>

    <record id="hotel_booking_view_form" model="ir.ui.view">
        <field name="name">hotel.booking.form</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_check_in" string="Check In" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_check_out" string="Check Out" type="object"
                            class="btn-primary" invisible="state != 'checked_in'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Guest">
                            <field name="guest_name"/>
                            <field name="guest_phone"/>
                            <field name="guest_email"/>
                        </group>
                        <group string="Stay">
                            <field name="room_id"
                                   readonly="state in ('checked_out', 'cancelled')"/>
                            <field name="check_in"
                                   readonly="state in ('checked_out', 'cancelled')"/>
                            <field name="check_out"
                                   readonly="state in ('checked_out', 'cancelled')"/>
                            <field name="nights"/>
                        </group>
                    </group>
                    <group string="Price">
                        <field name="currency_id" invisible="1"/>
                        <field name="price_per_night"/>
                        <field name="total_price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_booking_view_search" model="ir.ui.view">
        <field name="name">hotel.booking.search</field>
        <field name="model">hotel.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="guest_name"/>
                <field name="room_id"/>
                <filter name="active_bookings" string="Active"
                        domain="[('state', 'in', ('draft', 'confirmed', 'checked_in'))]"/>
                <filter name="confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="in_house" string="In House"
                        domain="[('state', '=', 'checked_in')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_room" string="Room" context="{'group_by': 'room_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hotel_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">hotel.booking</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
