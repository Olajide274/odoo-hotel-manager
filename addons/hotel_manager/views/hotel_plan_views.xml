<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_plan_view_list" model="ir.ui.view">
        <field name="name">hotel.plan.list</field>
        <field name="model">hotel.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="max_rooms_display"/>
                <field name="max_users_display"/>
                <field name="price_monthly"/>
                <field name="price_onetime"/>
                <field name="trial_days"/>
            </list>
        </field>
    </record>

    <record id="hotel_plan_view_form" model="ir.ui.view">
        <field name="name">hotel.plan.form</field>
        <field name="model">hotel.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Plan">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Pricing (NGN)">
                            <field name="price_monthly"/>
                            <field name="price_onetime"/>
                            <field name="trial_days"/>
                        </group>
                    </group>
                    <group>
                        <group string="Limits (0 = unlimited)">
                            <field name="max_rooms"/>
                            <field name="max_users"/>
                        </group>
                        <group string="Features">
                            <field name="has_custom_domain"/>
                            <field name="has_full_reports"/>
                            <field name="has_priority_support"/>
                            <field name="has_custom_branding"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hotel_plan_action" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">hotel.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="res_company_form_hotel_plan" model="ir.ui.view">
        <field name="name">res.company.form.hotel.plan</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Hotel Plan" name="hotel_plan">
                    <group>
                        <field name="hotel_plan_id"/>
                        <field name="trial_end_date"/>
                        <field name="is_trial_active"/>
                        <field name="hotel_requested_plan_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
