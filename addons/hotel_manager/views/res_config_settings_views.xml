<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hotel" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hotel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Hotel Manager" name="hotel_manager">
                    <block title="Paystack Payment">
                        <setting string="Paystack Secret Key" help="Required for webhook signature verification">
                            <field name="paystack_secret_key" password="True"/>
                        </setting>
                        <setting string="Paystack Public Key">
                            <field name="paystack_public_key"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
